# ==============================================================================
# Job Application Automation Kit — Environment Configuration Example
# Copy this file to .env and fill in values locally. Never commit .env to git.
# ==============================================================================

# --- Storage Backend ("local" works with zero Google setup; "google" enables Drive/Sheets) ---
STORAGE_BACKEND=local

# --- Local Paths (used by both modes for PDF output/checkpoints, and as primary store in local mode) ---
LOCAL_DATA_DIR=./data
CV_OUTPUT_DIR=./data/cvs
ARTIFACTS_DIR=./data/artifacts
CACHE_DIR=./data/cache

# --- Installer Config File Paths (copy config/*.example.json -> *.json and customize) ---
JOBKIT_PROFILE_PATH=./config/profile.json
JOBKIT_RULES_PATH=./config/rules.json
JOBKIT_ANSWERS_PATH=./config/answers.json
JOBKIT_TARGETS_PATH=./config/targets.json

# --- Browser / Chrome CDP Runtime ---
# Start Chrome/Chromium with: --remote-debugging-port=9222 --user-data-dir=<profile_dir>
CHROME_CDP_URL=http://127.0.0.1:9222
BROWSER_CHANNEL=chrome
BROWSER_HEADLESS=false

# --- Private Portal & CV Builder Credentials (Recommended: inject via OS keychain or local .env only) ---
PORTAL_LOGIN_EMAIL={{APPLICANT_EMAIL}}
PORTAL_PRIMARY_PASSWORD={{PORTAL_PRIMARY_PASSWORD}}
PORTAL_FALLBACK_PASSWORD={{PORTAL_FALLBACK_PASSWORD}}
FLOWCV_EMAIL={{FLOWCV_EMAIL}}
FLOWCV_PASSWORD={{FLOWCV_PASSWORD}}

# --- Optional Google Drive & Google Sheets Backend (Required ONLY if STORAGE_BACKEND=google) ---
GOOGLE_OAUTH_CLIENT_ID={{GOOGLE_OAUTH_CLIENT_ID}}
GOOGLE_OAUTH_CLIENT_SECRET={{GOOGLE_OAUTH_CLIENT_SECRET}}
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth2callback
# Store refresh/access token JSON outside the git repository with 0600 permissions:
GOOGLE_TOKEN_PATH=~/.config/job-automation-kit/google_token.json

# Private Google Sheet & Drive IDs (installer-owned)
SLOVAKIA_SHEET_ID={{PRIMARY_MARKET_SHEET_ID}}
SCHENGEN_SHEET_ID={{SECONDARY_MARKET_SHEET_ID}}
PRODUCTION_TRACKER_SHEET_ID={{PRODUCTION_TRACKER_SHEET_ID}}
GEMINI_TRACKER_SHEET_ID={{ASSISTANT_SYNC_SHEET_ID}}
DRIVE_ROOT_FOLDER_ID={{DRIVE_ROOT_FOLDER_ID}}
DRIVE_CV_ARCHIVE_FOLDER_ID={{DRIVE_CV_ARCHIVE_FOLDER_ID}}
DRIVE_SPONSOR_XLSX_PATH=./data/sponsor_directory.xlsx
